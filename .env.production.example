# ==============================================================================
# AYURVEDACARE CLINIC PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. APPLICATION ENVIRONMENT & NETWORKING
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://clinic.yourdomain.com"

# 2. DATABASE CONFIGURATION
# Connect to your production PostgreSQL instance (AWS RDS, Supabase, Neon, GCP Cloud SQL)
# Ensure connection pooling (e.g. PgBouncer) is configured with ?pgbouncer=true or direct connection
DATABASE_URL="postgresql://clinic_prod_user:YourStrongProductionPassword123!@db-host.internal:5432/clinic_production?schema=public&sslmode=require&connection_limit=20"

# 3. AUTHENTICATION & SECURE COOKIE SESSIONS
# Minimum 32 characters high-entropy random string (generate with: openssl rand -base64 48)
JWT_SECRET="generate-a-strong-random-production-jwt-secret-minimum-48-chars-long"
SESSION_COOKIE_NAME="__Host-ayurvedacare_session"

# Initial Super Admin Seed Credentials (used only once by npm run db:seed)
ADMIN_INITIAL_PASSWORD="SecureSuperAdminProdPassword2026!"

# 4. MEDIA & FILE STORAGE
# Supported drivers: "local" (default with persistent volume) or "s3"
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# Optional Cloud Storage (AWS S3 / Cloudflare R2 / MinIO)
# S3_BUCKET_NAME="ayurvedacare-media-prod"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# S3_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3_PUBLIC_BASE_URL="https://media.yourdomain.com"

# 5. PAYMENT GATEWAY INTEGRATIONS
# Minimum advance deposit per appointment is ₹100
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 6. NOTIFICATION CHANNELS & PROVIDERS
# Email Notification Provider (Resend / AWS SES / SendGrid / SMTP)
EMAIL_PROVIDER="mock"
EMAIL_FROM_ADDRESS="care@yourdomain.com"
EMAIL_FROM_NAME="AyurvedaCare Medical Desk"
RESEND_API_KEY=""

# SMS Gateway (Twilio / Gupshup / Msg91)
SMS_PROVIDER="mock"
SMS_SENDER_ID="AYURMD"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# WhatsApp Business API (Meta Cloud API / Twilio WhatsApp)
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 7. SECURITY & RATE LIMITING
# Rate limit window in seconds and maximum requests per window
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ========================================================
# CLINIC PLATFORM ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure values for your environment.
# ========================================================

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinic_platform?schema=public"

# Session JWT Encryption Key (Minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="super_secret_jwt_key_that_is_at_least_32_chars_long_clinic_2026"

# Environment
NODE_ENV="development"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Cookie Name
SESSION_COOKIE_NAME="clinic_auth_session"

# Initial Super Admin Creation (Optional - for npm run admin:create)
# ADMIN_INITIAL_PASSWORD=""
